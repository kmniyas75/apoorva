# ==============================================================================
# APOORVA ATELIER - PAYMENT GATEWAY & EMAIL NOTIFICATIONS CONFIGURATION
# ==============================================================================

# --- Razorpay Payment Gateway (INR ₹) ---
# Obtain from Razorpay Dashboard > Settings > API Keys
# Test keys format: rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_ID="rzp_test_yourKeyHere"
RAZORPAY_KEY_SECRET="yourRazorpaySecretHere"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_yourKeyHere"

# --- Resend Email Notification System ---
# Obtain from https://resend.com/api-keys
# Format: re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY="re_yourResendApiKeyHere"

# Sender address (Use onboarding@resend.dev for testing or your verified domain like orders@yourdomain.com)
RESEND_FROM_EMAIL="APOORVA Atelier <onboarding@resend.dev>"

# Store Administrator Email for "New Order Acquisition" alerts
ADMIN_NOTIFICATION_EMAIL="concierge@apoorva.luxury"

# Public site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Courier & Live Shipment Tracking APIs ---
# Option A: Shiprocket Automated Dispatch & Tracking
# Enter your Shiprocket account login credentials (from shiprocket.in):
SHIPROCKET_EMAIL="your_shiprocket_email@example.com"
SHIPROCKET_PASSWORD="your_shiprocket_password"
SHIPROCKET_PICKUP_LOCATION="Alappuzha Atelier" # Name configured in Shiprocket > Settings > Pickup Address

# Optional static API token:
SHIPROCKET_API_TOKEN="your_shiprocket_api_token_here"

# Option B: Direct Delhivery Waybill API:
DELHIVERY_API_KEY="your_delhivery_api_key_here"


